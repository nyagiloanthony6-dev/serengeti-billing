# Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: used by the monthly billing job. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects the daily billing job (any long random string)
CRON_SECRET=change-me-to-a-long-random-string

# Public address of this app, used in reminder messages
APP_URL=https://admin.serengetilabs.co.tz

# Optional: SMS reminders via Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Optional: email reminders via Resend
RESEND_API_KEY=
EMAIL_FROM=Serengeti Labs <billing@serengetilabs.co.tz>
